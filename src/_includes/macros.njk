      if (inRange) inRange.value = inEl.value;
      outEl.value = btn.getAttribute("data-out") || "30";
      if (outRange) outRange.value = outEl.value;
      cacheEl.value = btn.getAttribute("data-cache") || "50";
      batchEl.value = btn.getAttribute("data-batch") || "25";
      compute(true);
    });
  });
  compute(false);
})();
</script>
{% endmacro %}

