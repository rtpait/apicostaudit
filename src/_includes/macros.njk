  </div>
  <div class="calc-controls-grid">
    <div class="calc-field">
      <label for="ltc-in">1. Monthly Input Tokens (Millions: 1M–5,000M): <span id="ltc-in-lbl">{{ inM }}M</span></label>
      <input type="number" id="ltc-in" min="1" max="5000" value="{{ inM }}">
      <input type="range" id="ltc-in-range" min="1" max="5000" step="10" value="{{ inM }}" aria-label="Monthly Input Tokens Millions">
    </div>
    <div class="calc-field">
      <label for="ltc-out">2. Monthly Output Tokens (Millions: 1M–2,000M): <span id="ltc-out-lbl">{{ outM }}M</span></label>
      <input type="number" id="ltc-out" min="1" max="2000" value="{{ outM }}">
      <input type="range" id="ltc-out-range" min="1" max="2000" step="5" value="{{ outM }}" aria-label="Monthly Output Tokens Millions">
    </div>
    <div class="calc-field">
      <label for="ltc-cache">3. Prompt Cache Read Hit Share (0%–95%): <span id="ltc-cache-lbl">{{ cachePct }}%</span></label>
      <input type="number" id="ltc-cache" min="0" max="95" value="{{ cachePct }}">
      <small>90% off cached reads on Claude 4.5 · 75% off Gemini · 50% off OpenAI</small>
    </div>
    <div class="calc-field">
      <label for="ltc-batch">4. Async 24h Batch API Share (0%–100%): <span id="ltc-batch-lbl">{{ batchPct }}%</span></label>
      <input type="number" id="ltc-batch" min="0" max="100" value="{{ batchPct }}">
      <small>50% discount on non-real-time eval, ETL &amp; classification jobs</small>
    </div>
  </div>
  <div class="calc-output-grid" id="ltc-results-grid">
    <div class="calc-vendor-card vendor-best">
      <small>OpenAI GPT-5 / GPT-4o</small>
      <strong class="calc-big" id="ltc-openai-yr">$5,355/yr</strong>
      <span class="calc-sub" id="ltc-openai-sub">$446/mo · $2.50/1M in ($1.25 cached) · $10.00/1M out</span>
      <div style="margin-top:.55rem">
        <a class="cta tbl-cta-btn" data-partner="Generic API Infra Slot (DigitalOcean GPU)" data-cta-slot="llm_token_calc" data-funnel-role="mid_content" data-4axis-key="generic_api_partner_slot:api_llm_do_gpu_calc_mid:API_COSTS.llm_token_api:mid_content" data-route-slug="{{ sSlug }}" data-clickref="api_llm_do_gpu_calc_mid_{{ sSlug }}" href="https://www.digitalocean.com/pricing/gpu-droplets?utm_source=apicostaudit.com&amp;utm_medium=affiliate&amp;sid=8108003&amp;clickref=api_llm_do_gpu_calc_mid_{{ sSlug }}" target="_blank" rel="sponsored nofollow noopener">Compare H100 GPU Breakeven →</a>
      </div>
    </div>
    <div class="calc-vendor-card vendor-best">
      <small>Anthropic Claude 4.5 Sonnet</small>
      <strong class="calc-big" id="ltc-sonnet-yr">$6,998/yr</strong>
      <span class="calc-sub" id="ltc-sonnet-sub">$583/mo · $3.00/1M in ($0.30 cached 90% off) · $15/1M out</span>
      <div style="margin-top:.55rem">
        <a class="cta tbl-cta-btn" data-partner="Generic API Slot (Pinecone RAG)" data-cta-slot="llm_token_calc" data-funnel-role="mid_content" data-4axis-key="generic_api_partner_slot:api_llm_pinecone_calc_mid:API_COSTS.llm_token_api:mid_content" data-route-slug="{{ sSlug }}" data-clickref="api_llm_pinecone_calc_mid_{{ sSlug }}" href="https://www.pinecone.io/pricing/?utm_source=apicostaudit.com&amp;utm_medium=affiliate&amp;clickref=api_llm_pinecone_calc_mid_{{ sSlug }}" target="_blank" rel="sponsored nofollow noopener">Cut Context Tokens via Pinecone RAG →</a>
      </div>
    </div>
    <div class="calc-vendor-card">
      <small>Anthropic Claude 4.5 Opus</small>
      <strong class="calc-big" id="ltc-opus-yr">$34,992/yr</strong>
      <span class="calc-sub" id="ltc-opus-sub">$2,916/mo · $15/1M in ($1.50 cached) · $75/1M out</span>
      <div style="margin-top:.55rem">
        <a class="cta-secondary tbl-cta-btn" data-partner="Generic API Slot (ElevenLabs Voice)" data-cta-slot="llm_token_calc" data-funnel-role="mid_content" data-4axis-key="generic_api_partner_slot:api_voice_retell_mid_placeholder:API_COSTS.voice_video_api:mid_content" data-route-slug="{{ sSlug }}" data-clickref="api_voice_retell_mid_{{ sSlug }}" href="https://elevenlabs.io/pricing?utm_source=apicostaudit.com&amp;utm_medium=affiliate&amp;clickref=api_voice_retell_mid_{{ sSlug }}" target="_blank" rel="sponsored nofollow noopener">Audit Voice AI API Stack →</a>
      </div>
    </div>
    <div class="calc-vendor-card vendor-best">
      <small>Gemini 2.5 Pro / Flash</small>
      <strong class="calc-big" id="ltc-gemini-yr">$4,007/yr</strong>
      <span class="calc-sub" id="ltc-gemini-sub">Pro: $334/mo ($1.25/$10) · Flash: $301/yr ($0.15/$0.60)</span>
    </div>
    <div class="calc-vendor-card vendor-best">
      <small>DeepSeek R1/V3 &amp; Llama 4</small>
      <strong class="calc-big" id="ltc-deepseek-yr">$543/yr</strong>
      <span class="calc-sub" id="ltc-deepseek-sub">DeepSeek: $45/mo ($0.27/$1.10) · Llama 4: $324/yr ($0.20/$0.60)</span>
      <div style="margin-top:.55rem">
        <a class="cta-secondary tbl-cta-btn" data-partner="Generic API Slot (RunPod GPU)" data-cta-slot="llm_token_calc" data-funnel-role="mid_content" data-4axis-key="generic_api_partner_slot:api_llm_runpod_calc_mid:API_COSTS.gpu_vector_infra:mid_content" data-route-slug="{{ sSlug }}" data-clickref="api_llm_runpod_calc_mid_{{ sSlug }}" href="https://www.runpod.io/pricing?utm_source=apicostaudit.com&amp;utm_medium=affiliate&amp;clickref=api_llm_runpod_calc_mid_{{ sSlug }}" target="_blank" rel="sponsored nofollow noopener">Run Private Pod ($1.89/hr) →</a>
