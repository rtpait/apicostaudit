{% macro breadcrumbs(site, items) %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for i in items %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ i[0] | json | safe }},"item":"{{ site.url }}{{ i[1] }}"}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list">{% for i in items %}<li>{% if not loop.last %}<a href="{{ i[1] }}">{{ i[0] }}</a> <span aria-hidden="true">›</span> {% else %}<span aria-current="page">{{ i[0] }}</span>{% endif %}</li>{% endfor %}</ol></nav>
{% endmacro %}

