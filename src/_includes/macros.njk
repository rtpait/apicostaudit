    <p style="margin:.2rem 0 0;font-size:.86rem;color:#065f46" id="ltc-breakeven-detail">Enabling 50% Prompt Caching + 25% Batch API saves 34%–58% vs. uncached synchronous API calls. Dedicated 1x H100 GPU ($1,960/mo on RunPod/DigitalOcean) breaks even once monthly frontier API spend exceeds ~$2,000/mo.</p>
  </div>
</section>
<script>
(function(){
  var inEl = document.getElementById("ltc-in");
  var inRange = document.getElementById("ltc-in-range");
  var outEl = document.getElementById("ltc-out");
  var outRange = document.getElementById("ltc-out-range");
  var cacheEl = document.getElementById("ltc-cache");
  var batchEl = document.getElementById("ltc-batch");
  if (!inEl || !outEl) return;
  function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }
  function compute(fromUser) {
    var inM = Math.max(1, parseFloat(inEl.value || "120"));
    var outM = Math.max(1, parseFloat(outEl.value || "30"));
    var cPct = Math.max(0, Math.min(95, parseFloat(cacheEl.value || "50"))) / 100.0;
    var bPct = Math.max(0, Math.min(100, parseFloat(batchEl.value || "25"))) / 100.0;
    document.getElementById("ltc-in-lbl").textContent = inM + "M";
    document.getElementById("ltc-out-lbl").textContent = outM + "M";
    document.getElementById("ltc-cache-lbl").textContent = Math.round(cPct * 100) + "%";
    document.getElementById("ltc-batch-lbl").textContent = Math.round(bPct * 100) + "%";
    var bFactor = 1.0 - (0.50 * bPct);
    var openaiMo = ((inM * (1 - cPct) * 2.50) + (inM * cPct * 1.25) + (outM * 10.00)) * bFactor;
    var sonnetMo = ((inM * (1 - cPct) * 3.00) + (inM * cPct * 0.30) + (outM * 15.00)) * bFactor;
    var opusMo = ((inM * (1 - cPct) * 15.00) + (inM * cPct * 1.50) + (outM * 75.00)) * bFactor;
    var gemProMo = ((inM * (1 - cPct) * 1.25) + (inM * cPct * 0.31) + (outM * 10.00)) * bFactor;
    var gemFlashMo = ((inM * (1 - cPct) * 0.15) + (inM * cPct * 0.0375) + (outM * 0.60)) * bFactor;
    var dsMo = ((inM * (1 - cPct) * 0.27) + (inM * cPct * 0.07) + (outM * 1.10)) * bFactor;
    var llamaMo = ((inM * (1 - cPct) * 0.20) + (inM * cPct * 0.10) + (outM * 0.60)) * bFactor;
    document.getElementById("ltc-openai-yr").textContent = fmt(openaiMo * 12) + "/yr";
    document.getElementById("ltc-openai-sub").textContent = fmt(openaiMo) + "/mo · $2.50/1M in ($1.25 cached) · $10/1M out";
    document.getElementById("ltc-sonnet-yr").textContent = fmt(sonnetMo * 12) + "/yr";
    document.getElementById("ltc-sonnet-sub").textContent = fmt(sonnetMo) + "/mo · $3.00/1M in ($0.30 cached 90% off) · $15/1M out";
    document.getElementById("ltc-opus-yr").textContent = fmt(opusMo * 12) + "/yr";
    document.getElementById("ltc-opus-sub").textContent = fmt(opusMo) + "/mo · $15/1M in ($1.50 cached) · $75/1M out";
    document.getElementById("ltc-gemini-yr").textContent = fmt(gemProMo * 12) + "/yr";
    document.getElementById("ltc-gemini-sub").textContent = "Pro: " + fmt(gemProMo) + "/mo · Flash: " + fmt(gemFlashMo * 12) + "/yr (" + fmt(gemFlashMo) + "/mo)";
    document.getElementById("ltc-deepseek-yr").textContent = fmt(dsMo * 12) + "/yr";
    document.getElementById("ltc-deepseek-sub").textContent = "DeepSeek: " + fmt(dsMo) + "/mo · Llama 4: " + fmt(llamaMo * 12) + "/yr (" + fmt(llamaMo) + "/mo)";
    if (fromUser && window.posthog && typeof window.posthog.capture === "function") {
      window.posthog.capture("estimator_interaction", {product_domain: "apicostaudit.com", calculator: "llm_token_calc", input_m: inM, output_m: outM, cache_pct: Math.round(cPct*100), batch_pct: Math.round(bPct*100)});
    }
  }
  if (inRange) {
    inRange.addEventListener("input", function(){ inEl.value = inRange.value; compute(true); });
    inEl.addEventListener("input", function(){ inRange.value = inEl.value; compute(true); });
  }
  if (outRange) {
    outRange.addEventListener("input", function(){ outEl.value = outRange.value; compute(true); });
    outEl.addEventListener("input", function(){ outRange.value = outEl.value; compute(true); });
  }
  [cacheEl, batchEl].forEach(function(el){ if (el) el.addEventListener("input", function(){ compute(true); }); });
  compute(false);
})();
</script>
{% endmacro %}

