  var hEl = document.getElementById("gtc-hours");
  var eEl = document.getElementById("gtc-egress");
  function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }
  function compute() {
    var g = Math.max(1, parseInt(gEl.value || "2", 10));
    var h = Math.max(1, Math.min(24, parseInt(hEl.value || "24", 10)));
    var eg = Math.max(0, parseInt(eEl.value || "2000", 10));
    document.getElementById("gtc-gpus-lbl").textContent = String(g);
    document.getElementById("gtc-hours-lbl").textContent = h + "h";
    document.getElementById("gtc-egress-lbl").textContent = eg.toLocaleString("en-US") + " GB";
    var moHours = g * h * 30.4;
    var doYr = (moHours * 2.99 + Math.max(0, eg - 5000) * 0.01) * 12;
    var rpYr = (moHours * 2.69 + eg * 0.01) * 12;
    var awsYr = (moHours * 6.88 + eg * 0.09) * 12;
    document.getElementById("gtc-do-yr").textContent = fmt(doYr) + "/yr";
    document.getElementById("gtc-runpod-yr").textContent = fmt(rpYr) + "/yr";
    document.getElementById("gtc-runpod-sub").textContent = "Saves " + fmt(Math.max(0, awsYr - rpYr)) + "/yr vs. AWS P5 (" + fmt(awsYr) + "/yr)";
  }
  [gEl, hEl, eEl].forEach(function(el){ if (el) el.addEventListener("input", compute); });
